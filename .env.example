# ──────────────────────────────────────────────────────────
# Neon Postgres
# ──────────────────────────────────────────────────────────
# Pooled connection (use for app queries)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct connection (use ONLY for migrations / drizzle-kit)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ──────────────────────────────────────────────────────────
# Better Auth
# ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# Base URL of this app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────
# Admin allowlist
# ──────────────────────────────────────────────────────────
# Comma-separated emails allowed to sign in to /admin.
# Public signup is disabled — only emails listed here can ever
# be created or used. Bootstrap your account with:
#   npm run admin:create -- you@example.com 'password' "Your Name"
ADMIN_EMAILS=you@example.com

# ──────────────────────────────────────────────────────────
# Resend (transactional email — password reset, verification)
# ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ──────────────────────────────────────────────────────────
# Cloudinary (image uploads in the admin: avatar in /admin/settings,
# skill images in /admin/skills, About-page images in /admin/about)
# ──────────────────────────────────────────────────────────
# From your Cloudinary dashboard (cloudinary.com/console). The free tier
# is plenty for this site. Without these three, uploads fail with a clear error.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
