# ============================================================
# Neon PostgreSQL
# Get from https://console.neon.tech
# Connection string format:
# postgresql://user:password@neon-host/dbname
# ============================================================
DATABASE_URL="postgresql://user:password@host/dbname"

# ============================================================
# Better Auth
# Generate secret with: openssl rand -base64 32
# ============================================================
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="https://yoursite.vercel.app" # or http://localhost:3000 for dev
NEXT_PUBLIC_APP_URL="https://yoursite.vercel.app"

# ============================================================
# Resend Email Service
# Get from https://resend.com
# RESEND_FROM_EMAIL should be a verified sender domain
# ============================================================
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="noreply@mahtamunhoquefahim.com"
