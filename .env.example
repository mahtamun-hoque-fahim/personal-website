# ============================================================
# Neon PostgreSQL
# Get from https://console.neon.tech
# Connection string format:
# postgresql://user:password@neon-host/dbname
# ============================================================
DATABASE_URL="postgresql://user:password@host/dbname"

# ============================================================
# Better Auth
# Generate secret with: openssl rand -base64 32
# ============================================================
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="https://yoursite.vercel.app" # or http://localhost:3000 for dev
NEXT_PUBLIC_APP_URL="https://yoursite.vercel.app"

# ============================================================
# Google OAuth
# Get from https://console.cloud.google.com
# Authorized redirect URI: https://yoursite.com/api/auth/callback/google
# ============================================================
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
