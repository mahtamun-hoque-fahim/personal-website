          "type": "text",
          "primaryKey": false,
          "notNull": true,
          "default": "'Developer who designs.'"
        },
        "intro": {
          "name": "intro",
          "type": "text",
          "primaryKey": false,
          "notNull": true,
          "default": "'I''m Mahtamun Hoque Fahim. I grew up in Bangladesh with an internet connection and an obsession with how things look and work. That combination became a career.'"
        },
        "story_heading": {
          "name": "story_heading",
          "type": "text",
          "primaryKey": false,
          "notNull": true,
          "default": "'The honest story'"
        },
        "story_paragraphs": {
          "name": "story_paragraphs",
          "type": "text[]",
          "primaryKey": false,
          "notNull": true,
          "default": "ARRAY['I didn''t study design in a formal school. I learned by obsessively reverse-engineering things I loved: breaking down why a logo felt trustworthy, why a website felt fast, why some interfaces made you feel calm.','I started building websites because I couldn''t communicate what I wanted to developers. I started designing seriously because I couldn''t stand ugly interfaces. Both accidents became strengths.','Being from Bangladesh sharpened me. I couldn''t rely on proximity to opportunity, so I had to be undeniably good. That''s still the standard I hold myself to.','I care about work that ships, that works, that people actually use. Beautiful for its own sake doesn''t interest me. Beautiful and functional? That''s the whole game.']::text[]"
        },
        "cta_heading": {
          "name": "cta_heading",
          "type": "text",
          "primaryKey": false,
          "notNull": true,
          "default": "'Want to work together?'"
        },
        "cta_text": {
          "name": "cta_text",
          "type": "text",
          "primaryKey": false,
          "notNull": true,
          "default": "'I''m selective about what I take on, which means I care about what you''re building.'"
        },
        "cta_primary_label": {
          "name": "cta_primary_label",
          "type": "text",
          "primaryKey": false,
          "notNull": true,
